# Frontend dashboard env
# These are exposed to the browser because Vite exposes VITE_* variables.
# Do not put secrets here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=https://discord-bot-eta-ten.vercel.app/login

# Must point to deployed backend API, not the frontend Vercel URL.
VITE_BOT_API_URL=https://discord-bot-api-production.up.railway.app
