# Backend API / Discord bot env

# Port for local API server
API_PORT=3000

# Dashboard origin allowed by CORS
DASHBOARD_URL=https://discord-bot-eta-ten.vercel.app

# Random backend-only API secret. Never expose this to frontend.
API_SECRET=replace_with_random_secret

# Firebase Admin SDK service account JSON as one-line JSON string.
# Do not commit the real value.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# Existing bot env variables
TOKEN=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
AUTO_ROLE_ID=
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
